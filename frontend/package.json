{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Maati desktop break companion",
  "author": "Maati Project",
  "main": "main.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "desktop:pack": "electron-builder --dir",
    "desktop:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.maati.desktop",
    "productName": "Maati",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "package.json"],
    "npmRebuild": false,
    "protocols": [{ "name": "Maati Desktop Companion", "schemes": ["maati"] }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Maati-Setup-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
